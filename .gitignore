# ============================================
# ПРОВЕРКА БЕЗОПАСНОСТИ
# ============================================
# Команды для проверки:
# git ls-files | grep -E '\.(env|key|pem|secret)' 
# (не должно ничего выводить)

# git status --ignored
# (покажет игнорируемые файлы)

# ============================================
# АВТОМАТИЧЕСКАЯ ПРОВЕРКА
# ============================================
# Добавьте в package.json:
# "scripts": {
#   "security-check": "git ls-files | grep -E '\\.(env|key|pem|secret)' && echo 'НАЙДЕНЫ СЕКРЕТНЫЕ ФАЙЛЫ!' || echo 'Безопасность OK'"
# }

